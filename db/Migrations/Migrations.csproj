<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project intentionally predates and is separate from a future
    api/ project (ASP.NET Core, Epic 2). EF Core migrations need a .NET
    project to host `dotnet ef` tooling, and the full API doesn't exist
    yet, so this scaffolds just enough to run
    `dotnet ef migrations add` / `dotnet ef database update` against the
    `db` docker-compose service. See db/Migrations/README.md for details.
    A future api/ project can reference or absorb this project without a
    disruptive move.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
